# ==========================================
# Pharmacy ERP - Environment Configuration Example
# Copy this file to .env and configure your values:
#   cp .env.example .env
# ==========================================

# Django Secret Key (Generate a secure unique key for production)
SECRET_KEY=your-super-secret-key-change-in-production

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated, e.g. localhost,127.0.0.1,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated with scheme, required for forms/proxies)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

# Application Timezone
TIME_ZONE=Asia/Kolkata

# SSL & Cookie Security (set to True in production with HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
